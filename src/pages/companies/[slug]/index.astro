---
import Layout from '../../../layouts/Layout.astro';
import { createSupabaseClient } from '../../../lib/supabase';
import AstroCard from '../../../components/AstroCard.astro';
import AstroButton from '../../../components/AstroButton.astro';
import AstroBadge from '../../../components/AstroBadge.astro';
import { Input } from '../../../components/ui/input';
import { Label } from '../../../components/ui/label';
import { Users, Plus, Link, Search, Copy, Check, Folder, ChevronDown } from 'lucide-react';

const { slug } = Astro.params;
const supabase = createSupabaseClient(Astro.cookies);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect('/login');

const { data: company } = await supabase
  .from('companies')
  .select('*')
  .eq('slug', slug)
  .single();

if (!company) return Astro.redirect('/companies');

let errorMsg = '';

const [memberInfoRes, profileRes] = await Promise.all([
  supabase
    .from('company_members')
    .select('role')
    .eq('company_id', company.id)
    .eq('user_id', session.user.id)
    .maybeSingle(),
  supabase
    .from('profiles')
    .select('role')
    .eq('id', session.user.id)
    .single()
]);


const isCompanyAdmin = memberInfoRes.data?.role === 'admin';
const isGlobalAdmin = profileRes.data?.role === 'admin';
const isAdmin = isGlobalAdmin || isCompanyAdmin;

if (!isAdmin) {
  return Astro.redirect('/dashboard');
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('_action');

  if (action === 'create_team') {
    if (!isAdmin) {
      errorMsg = 'Unauthorized';
    } else {
      const name = (formData.get('team_name') || '').toString().trim();
      if (!name) {
        errorMsg = 'Team name is required';
      } else {
        const invite_code = crypto.randomUUID();
        const { error } = await supabase
          .from('teams')
          .insert({ company_id: company.id, name, invite_code, created_by: session.user.id });
        if (!error) {
          return Astro.redirect(`/companies/${slug}`);
        } else {
          errorMsg = error.message;
        }
      }
    }
  }
}

const [teamsRes, membersRes] = await Promise.all([
  supabase.from('teams').select('*').eq('company_id', company.id).order('name'),
  supabase.from('company_members').select('role, user_id, profiles(full_name, email)').eq('company_id', company.id)
]);

const teams = teamsRes.data || [];
const members = membersRes.data || [];
---

<Layout title={`${company.name} - Details`}>
  <main class="w-full max-w-7xl mx-auto p-6 md:p-8">
    <nav class="flex items-center gap-2 text-sm text-muted-foreground mb-6">
      <a href="/companies" class="hover:text-foreground transition-colors">Companies</a>
      <span class="text-muted-foreground/30">/</span>
      <span class="text-foreground font-medium">{company.name}</span>
    </nav>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-border mb-8">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-semibold tracking-tight text-foreground">{company.name}</h1>
          {isAdmin && (
            <AstroBadge variant="secondary" className="bg-primary/10 text-primary border-primary/20 hover:bg-primary/10">
              Company Admin
            </AstroBadge>
          )}
        </div>
        <p class="text-muted-foreground mt-1 text-sm">Manage teams and view roster membership within the company.</p>
        <div class="flex gap-2.5 mt-3">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-accent text-accent-foreground border border-border">
            <Folder className="w-3.5 h-3.5 text-muted-foreground" />
            {teams.length} {teams.length === 1 ? 'Team' : 'Teams'}
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-accent text-accent-foreground border border-border">
            <Users className="w-3.5 h-3.5 text-muted-foreground" />
            {members.length} {members.length === 1 ? 'Member' : 'Members'}
          </span>
        </div>
      </div>
    </div>

    {errorMsg && (
      <div class="p-4 mb-6 text-sm text-red-500 bg-red-50 rounded-lg border border-red-200">
        {errorMsg}
      </div>
    )}

    <div class="space-y-6">
      <!-- Teams Toolbar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="relative w-full sm:max-w-xs">
          <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground" />
          <Input
            id="team-search"
            type="text"
            placeholder="Search teams..."
            className="pl-9 w-full bg-background"
          />
        </div>
        {isAdmin && (
          <AstroButton size="sm" id="show-create-team-btn" onclick="document.getElementById('create-team-card').classList.remove('hidden')">
            <Plus className="w-4 h-4 mr-1" /> Create Team
          </AstroButton>
        )}
      </div>

      <!-- Create Team Card (Hidden by default) -->
      <div id="create-team-card" class="hidden">
        <AstroCard className="p-5 border-primary/30 max-w-xl">
          <h3 class="text-base font-semibold mb-3">New Team</h3>
          <form method="post" class="space-y-4">
            <input type="hidden" name="_action" value="create_team" />
            <div class="space-y-1.5">
              <Label htmlFor="team_name">Team Name</Label>
              <Input id="team_name" name="team_name" required placeholder="e.g. engineering, design, marketing" />
            </div>
            <div class="flex gap-2 justify-end">
              <AstroButton type="button" variant="outline" size="sm" onclick="document.getElementById('create-team-card').classList.add('hidden')">
                Cancel
              </AstroButton>
              <AstroButton type="submit" size="sm">
                Create Team
              </AstroButton>
            </div>
          </form>
        </AstroCard>
      </div>

      <!-- Teams Grid -->
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {teams.map(t => {
          const inviteUrl = `${Astro.url.origin}/teams/join/${t.invite_code}`;
          return (
            <div class="team-card" data-team-name={t.name}>
              <AstroCard className="p-5 flex flex-col justify-between hover:shadow-md transition-all duration-200 h-full border border-border bg-card">
                <div class="space-y-4">
                  <div class="flex items-start justify-between gap-2">
                    <h3 class="font-semibold text-base text-foreground truncate" title={t.name}>{t.name}</h3>
                  </div>
                  
                  {isAdmin && (
                    <div class="space-y-1.5 text-xs text-muted-foreground bg-muted/40 p-2.5 rounded-lg border border-border/60">
                      <div class="flex items-center justify-between gap-1">
                        <span class="flex items-center gap-1 font-medium text-foreground/80">
                          <Link className="w-3.5 h-3.5 text-muted-foreground" /> Invite Link
                        </span>
                        <button
                          type="button"
                          class="copy-btn p-1 rounded hover:bg-muted transition-colors text-muted-foreground hover:text-foreground"
                          data-copy-text={inviteUrl}
                          title="Copy invite link"
                          aria-label="Copy invite link"
                        >
                          <Copy className="w-3.5 h-3.5 copy-icon" />
                          <Check className="w-3.5 h-3.5 check-icon hidden text-green-500" />
                        </button>
                      </div>
                      <code class="block font-mono break-all mt-1 bg-background px-2 py-1.5 border rounded text-[10px] select-all text-muted-foreground">
                        {inviteUrl}
                      </code>
                    </div>
                  )}
                </div>
                
                <div class="flex gap-2 mt-4 pt-4 border-t border-border/50 justify-between items-center">
                  <a href={`/admin?team_id=${t.id}`} class="text-xs text-primary font-medium hover:underline">
                    Manage Events &rarr;
                  </a>
                  <a href={`/admin/roster?team_id=${t.id}`} class="text-xs text-primary font-medium hover:underline">
                    Manage Roster &rarr;
                  </a>
                </div>
              </AstroCard>
            </div>
          );
        })}
        {teams.length === 0 && (
          <div class="col-span-full p-12 text-center text-muted-foreground text-sm border rounded-lg bg-card">
            No teams in this company yet.
          </div>
        )}
      </div>
    </div>

    <details class="group bg-card border border-border rounded-lg mt-8">
      <summary class="flex justify-between items-center p-4 cursor-pointer font-semibold select-none">
        <span class="flex items-center gap-2">
          <Users className="w-5 h-5 text-muted-foreground" />
          Company Roster
        </span>
        <ChevronDown className="w-5 h-5 text-muted-foreground group-open:rotate-180 transition-transform duration-200" />
      </summary>
      <div class="p-4 border-t border-border space-y-4">
        <div class="relative w-full sm:max-w-xs">
          <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground" />
          <Input
            id="member-search"
            type="text"
            placeholder="Search members..."
            className="pl-9 w-full bg-background"
          />
        </div>
        <div class="divide-y divide-border">
          {members.map(m => {
            const p = (m.profiles as any) || {};
            const name = p.full_name || 'Anonymous Member';
            const email = p.email || 'No email';
            return (
              <div class="member-row py-3 flex items-center justify-between gap-2 first:pt-0 last:pb-0">
                <div class="min-w-0">
                  <p class="text-sm font-semibold truncate text-foreground">{name}</p>
                  <p class="text-xs text-muted-foreground truncate">{email}</p>
                </div>
                <AstroBadge variant={m.role === 'admin' ? 'default' : 'secondary'} className="shrink-0">
                  {m.role}
                </AstroBadge>
              </div>
            );
          })}
        </div>
      </div>
    </details>
  </main>
</Layout>

<script>
  // Search functionality
  const searchInput = document.getElementById('team-search') as HTMLInputElement | null;
  searchInput?.addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value.toLowerCase();
    document.querySelectorAll('.team-card').forEach((card) => {
      const name = card.getAttribute('data-team-name')?.toLowerCase() || '';
      if (name.includes(q)) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  });

  // Member search functionality
  const memberSearchInput = document.getElementById('member-search') as HTMLInputElement | null;
  memberSearchInput?.addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value.toLowerCase();
    document.querySelectorAll('.member-row').forEach((row) => {
      const text = row.textContent?.toLowerCase() || '';
      if (text.includes(q)) {
        row.classList.remove('hidden');
      } else {
        row.classList.add('hidden');
      }
    });
  });

  // Copy functionality
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    let timeoutId: ReturnType<typeof setTimeout> | undefined;
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy-text');
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);

        const copyIcon = btn.querySelector('.copy-icon');
        const checkIcon = btn.querySelector('.check-icon');

        if (copyIcon && checkIcon) {
          copyIcon.classList.add('hidden');
          checkIcon.classList.remove('hidden');

          if (timeoutId) {
            clearTimeout(timeoutId);
          }

          timeoutId = setTimeout(() => {
            copyIcon.classList.remove('hidden');
            checkIcon.classList.add('hidden');
            timeoutId = undefined;
          }, 2000);
        }
      } catch (err) {
        console.error('Failed to copy text: ', err);
      }
    });
  });
</script>
